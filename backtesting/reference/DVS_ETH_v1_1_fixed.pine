//@version=6
strategy("DVS ETH v1.1 | Bias + Structure + Volume", overlay=true,
     initial_capital=50000, currency=currency.USD,
     pyramiding=0, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.04,
     slippage=2, margin_long=20, margin_short=20)

// Apply to a standard 5-minute ETH perpetual chart.
riskUSD      = input.float(100, "Planned risk per trade ($)", minval=1)
rewardR      = input.float(2.0, "Reward / risk", minval=1, step=0.25)
maxLeverage  = input.float(5.0, "Maximum notional leverage", minval=1, maxval=5)
maxDailyLoss = input.float(300, "Personal daily loss limit ($)", minval=1)
maxTradesDay = input.int(3, "Maximum entries per day", minval=1)
maxSetupBars = input.int(24, "Retest window (5m bars)", minval=1)
breakoutRVOL = input.float(1.5, "15m breakout RVOL minimum", minval=0.1, step=0.1)
entryRVOL    = input.float(1.2, "5m confirmation RVOL minimum", minval=0.1, step=0.1)
retestATR    = input.float(0.25, "Retest tolerance (5m ATR)", minval=0, step=0.05)
stopATR      = input.float(0.1, "Stop buffer (5m ATR)", minval=0, step=0.05)

validChart = timeframe.in_seconds() == 300

// Read previous completed higher-timeframe candles to avoid lookahead.
dailyUp = request.security(syminfo.tickerid, "D", close[1] > close[2], lookahead=barmerge.lookahead_on)
dailyDn = request.security(syminfo.tickerid, "D", close[1] < close[2], lookahead=barmerge.lookahead_on)
ema4h = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
close4h = request.security(syminfo.tickerid, "240", close[1], lookahead=barmerge.lookahead_on)

// Confirmed 4H pivots, two candles on each side.
// Each value is taken from the last fully closed 4H bar.
h4new = request.security(syminfo.tickerid, "240", ta.valuewhen(not na(ta.pivothigh(high, 2, 2)), ta.pivothigh(high, 2, 2), 0)[1], lookahead=barmerge.lookahead_on)
h4old = request.security(syminfo.tickerid, "240", ta.valuewhen(not na(ta.pivothigh(high, 2, 2)), ta.pivothigh(high, 2, 2), 1)[1], lookahead=barmerge.lookahead_on)
l4new = request.security(syminfo.tickerid, "240", ta.valuewhen(not na(ta.pivotlow(low, 2, 2)), ta.pivotlow(low, 2, 2), 0)[1], lookahead=barmerge.lookahead_on)
l4old = request.security(syminfo.tickerid, "240", ta.valuewhen(not na(ta.pivotlow(low, 2, 2)), ta.pivotlow(low, 2, 2), 1)[1], lookahead=barmerge.lookahead_on)

bullBias = dailyUp and close4h > ema4h and h4new > h4old and l4new > l4old
bearBias = dailyDn and close4h < ema4h and h4new < h4old and l4new < l4old

// 15-minute structure and breakout confirmation.
// Pivot levels are read as of the bar preceding the breakout candle.
res15 = request.security(syminfo.tickerid, "15", ta.valuewhen(not na(ta.pivothigh(high, 2, 2)), ta.pivothigh(high, 2, 2), 0)[2], lookahead=barmerge.lookahead_on)
sup15 = request.security(syminfo.tickerid, "15", ta.valuewhen(not na(ta.pivotlow(low, 2, 2)), ta.pivotlow(low, 2, 2), 0)[2], lookahead=barmerge.lookahead_on)
c15 = request.security(syminfo.tickerid, "15", close[1], lookahead=barmerge.lookahead_on)
p15 = request.security(syminfo.tickerid, "15", close[2], lookahead=barmerge.lookahead_on)
v15 = request.security(syminfo.tickerid, "15", volume[1] / ta.sma(volume, 20)[2], lookahead=barmerge.lookahead_on)

new15 = timeframe.change("15")
longBreak = new15 and bullBias and not na(res15) and p15 <= res15 and c15 > res15 and v15 >= breakoutRVOL
shortBreak = new15 and bearBias and not na(sup15) and p15 >= sup15 and c15 < sup15 and v15 >= breakoutRVOL

atr5 = ta.atr(14)
volAverage5 = ta.sma(volume[1], 20)
rv5 = volAverage5 > 0 ? volume / volAverage5 : na

// Personal intraday limits. These do not reproduce the prop firm's rules.
var float dayStartEquity = na
var int entriesToday = 0
var bool dailyLocked = false
if na(dayStartEquity) or timeframe.change("D")
    dayStartEquity := strategy.equity
    entriesToday := 0
    dailyLocked := false
if strategy.equity <= dayStartEquity - maxDailyLoss
    dailyLocked := true
canTrade = not dailyLocked and entriesToday < maxTradesDay

// Setup states: +1 long, -1 short, 0 inactive.
var int setupDir = 0
var float setupLevel = na
var int setupBar = na
var bool retested = false
var float retestExtreme = na

expired = setupDir != 0 and (bar_index - setupBar > maxSetupBars or (setupDir == 1 and not bullBias) or (setupDir == -1 and not bearBias))
if expired or not canTrade
    setupDir := 0
    retested := false
    retestExtreme := na

if validChart and strategy.position_size == 0 and canTrade
    if longBreak or shortBreak
        setupDir := longBreak ? 1 : -1
        setupLevel := longBreak ? res15 : sup15
        setupBar := bar_index
        retested := false
        retestExtreme := na

// Wait for a separate pullback after the breakout was detected.
active = validChart and canTrade and strategy.position_size == 0 and setupDir != 0 and bar_index > setupBar
nearLevel = active and low <= setupLevel + retestATR * atr5 and high >= setupLevel - retestATR * atr5

if nearLevel and setupDir == 1 and close >= setupLevel
    retested := true
    retestExtreme := na(retestExtreme) ? low : math.min(retestExtreme, low)
if nearLevel and setupDir == -1 and close <= setupLevel
    retested := true
    retestExtreme := na(retestExtreme) ? high : math.max(retestExtreme, high)

// Invalidate if price closes convincingly through the retest level.
failedLong = active and setupDir == 1 and close < setupLevel - retestATR * atr5
failedShort = active and setupDir == -1 and close > setupLevel + retestATR * atr5
if failedLong or failedShort
    setupDir := 0
    retested := false
    retestExtreme := na

// Confirmation must occur after the retest candle, not on the same candle.
var int lastRetestBar = na
if nearLevel and retested
    lastRetestBar := bar_index

confirmLong = active and setupDir == 1 and retested and bar_index > lastRetestBar and close > open and close > high[1] and rv5 >= entryRVOL
confirmShort = active and setupDir == -1 and retested and bar_index > lastRetestBar and close < open and close < low[1] and rv5 >= entryRVOL

if barstate.isconfirmed and (confirmLong or confirmShort)
    isLong = confirmLong
    stopPrice = isLong ? retestExtreme - stopATR * atr5 : retestExtreme + stopATR * atr5
    stopDistance = math.abs(close - stopPrice)
    stopValid = isLong ? stopPrice < close : stopPrice > close
    if stopValid and stopDistance > syminfo.mintick
        sizeByRisk = riskUSD / (stopDistance * syminfo.pointvalue)
        sizeByLeverage = strategy.equity * maxLeverage / (close * syminfo.pointvalue)
        tradeQty = math.floor(math.min(sizeByRisk, sizeByLeverage) * 1000) / 1000
        targetPrice = isLong ? close + rewardR * stopDistance : close - rewardR * stopDistance
        if tradeQty > 0
            if isLong
                strategy.entry("Long", strategy.long, qty=tradeQty)
                strategy.exit("Long TP/SL", from_entry="Long", stop=stopPrice, limit=targetPrice)
            else
                strategy.entry("Short", strategy.short, qty=tradeQty)
                strategy.exit("Short TP/SL", from_entry="Short", stop=stopPrice, limit=targetPrice)
            entriesToday += 1
    setupDir := 0
    retested := false
    retestExtreme := na

plot(ema4h, "Previous confirmed 4H EMA 50", color=color.orange, linewidth=2)
plot(setupDir != 0 ? setupLevel : na, "Active retest level", color=color.aqua, style=plot.style_linebr, linewidth=2)
plotshape(longBreak and validChart, title="15m Bull Break", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="BOS")
plotshape(shortBreak and validChart, title="15m Bear Break", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="BOS")
bgcolor(bullBias ? color.new(color.green, 93) : bearBias ? color.new(color.red, 93) : na)

alertcondition(longBreak and validChart, "Bullish breakout", "DVS: confirmed 15m bullish breakout")
alertcondition(shortBreak and validChart, "Bearish breakout", "DVS: confirmed 15m bearish breakout")

if barstate.islast and not validChart
    label.new(bar_index, high, "DVS requires a standard 5-minute chart", style=label.style_label_down, color=color.red, textcolor=color.white)
